# ---------------------------------------------------------------
# Backend
# ---------------------------------------------------------------

# Comma-separated key pool (at least 2). Key ids are key_1, key_2, ... in this order.
LLM_API_KEYS=gsk_your-first-groq-key,gsk_your-second-groq-key

# Any LiteLLM model string. The same model is used for every key in the pool.
LLM_MODEL=groq/openai/gpt-oss-120b

# SQLite location. Four slashes = absolute path (inside the container's /data volume).
DATABASE_URL=sqlite:////data/app.db

# Comma-separated CORS origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:3000

# true enables the X-Simulate-Failure request header on POST /chat.
ENABLE_FAILURE_SIMULATION=true

# Used when a session does not set its own system prompt.
DEFAULT_SYSTEM_PROMPT=You are a helpful, concise assistant.

# LiteLLM in-memory response cache: entry lifetime and max entries.
CACHE_TTL_SECONDS=86400
CACHE_MAX_ITEMS=1000

# Per-key request timeout in seconds before failing over.
LLM_TIMEOUT_SECONDS=30

LOG_LEVEL=info

# ---------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------

# Backend base URL the browser should call.
API_BASE_URL=http://localhost:8000
